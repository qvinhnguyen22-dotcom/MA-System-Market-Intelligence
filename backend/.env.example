# =============================================================================
# AMA-System Market Intelligence — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# App
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# ── Market Intelligence API Keys (REQUIRED) ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── Legacy AI Providers (Phase 3+) ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Database (Phase 3+) ───────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ama_system

# ── Vector DB (Phase 3+) ──────────────────────────────────────────────────
# CHROMA_PERSIST_DIR=./data/chroma
